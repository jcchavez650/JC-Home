# Required: Anthropic API key used server-side to call Claude for food identification
# and nutrition estimation. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required: PostgreSQL connection string. On Railway, add the PostgreSQL plugin and
# it provides DATABASE_URL automatically. For managed Postgres that needs SSL, either
# include ?sslmode=require in the URL or set PGSSL=true.
DATABASE_URL=postgres://user:password@localhost:5432/carb_counter

# Required in production: secret used to sign auth (JWT) tokens. Use a long random string.
JWT_SECRET=

# Optional: force SSL for the Postgres connection (managed providers usually need this).
PGSSL=false

# Optional: override the Claude model (defaults to claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Optional: port the Express server listens on (Railway sets this automatically)
PORT=3001

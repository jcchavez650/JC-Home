# Required — generate a strong random value: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Required in production — your app's public URL (locks down CORS)
ALLOWED_ORIGIN=https://your-app.up.railway.app

# Required for AI photo scanning
ANTHROPIC_API_KEY=your_api_key_here

PORT=3001
DATA_DIR=/data
UPLOADS_DIR=/data/uploads

{
  "name": "JC Home Apps",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "cd tote-tracker/backend && npm install && cd ../frontend && npm install",
  "forwardPorts": [3001, 5173],
  "portsAttributes": {
    "3001": {
      "label": "Tote Tracker API",
      "onAutoForward": "silent",
      "visibility": "public"
    },
    "5173": {
      "label": "Tote Tracker UI",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
  }
}
